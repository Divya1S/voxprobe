# secrets — never commit
.env
.env.*
!.env.example

# python
__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
build/
.pytest_cache/

# local scratch (raw downloads before they are named/converted are kept out; final MP3/txt/json ARE committed)
recordings/raw/
tmp/
*.wav

# editor / os
.DS_Store
.vscode/
.idea/

# synthetic pipeline smoke-test artifacts (scripts/make_synthetic_call.py) — never evidence
recordings/*synthetic*
transcripts/*synthetic*
reports/*synthetic*
reports/events/synthetic-*
reports/events/test-*

# run outputs are local; curated demo runs live in examples/
recordings/*.mp3
transcripts/arena-*
transcripts/call-*
reports/arena-*
reports/call-*
reports/events/arena-*
reports/events/call-*
.ruff_cache/

# run recordings live in recordings/ locally; only curated copies under examples/ are committed
recordings/*.mp3

# operational logs/state of the inbound line and CALL-E runners (not evidence)
reports/line/*.log
reports/line/state.json
reports/calle/*.log
