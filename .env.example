# Copy to .env and fill in. Never commit .env.

# --- LLM providers (free tiers) — simulator brain + judge ---
GROQ_API_KEY=                          # console.groq.com  (primary LLM + Whisper re-transcription)
GROQ_MODEL=llama-3.3-70b-versatile     # 12K TPM on the free tier (measured); ~380 ms
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant   # separate 6K TPM bucket, tried before Gemini
GOOGLE_API_KEY=                        # aistudio.google.com (failover LLM + the sample agent in text mode)
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Speech (audio arena; also BYO key for phone adapters) ---
DEEPGRAM_API_KEY=                      # console.deepgram.com — optional; local STT/TTS can be used instead

# --- Optional phone adapter: Vapi (bring your own paid telephony) ---
VAPI_API_KEY=                          # PRIVATE key from dashboard.vapi.ai -> API Keys (server-side only)
VAPI_PHONE_NUMBER_ID=                  # UUID of the number calls are placed from
CALLER_NUMBER_E164=                    # that number in E.164, for the evidence bundle
ALLOWED_NUMBERS_E164=                  # comma-separated allow-list of numbers voxprobe may EVER dial (defense in depth)

# --- Brain server (only for phone adapters that call back into a custom-LLM endpoint) ---
PUBLIC_BASE_URL=                       # https tunnel URL; `voxprobe call` fills it automatically via cloudflared
BRAIN_SERVER_SECRET=                   # random string (openssl rand -hex 16); sent as Authorization: Bearer <secret>
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8000
